# ============================================================================
# predictive-maintenance-ai — environment template
# ============================================================================
# Copy to `.env` and edit per environment. The Python backend reads plain
# environment variables (a `.env` file is NOT auto-loaded by the backend;
# `set -a; source .env;` on POSIX or a process manager injects them).
#
# SECURITY: this project has no authentication and therefore requires no
# secrets today. If secrets are ever introduced (auth, SMTP, third-party
# APIs) they must be provided by the deployment secret manager - never
# committed here. Everything below is non-secret configuration only.

# ----------------------------------------------------------------------------
# Backend runtime profile (src/predictive_maintenance/api/config.py)
# ----------------------------------------------------------------------------

# Deployment profile: development (default) | production (fail-fast).
#   development  featured defaults: wildcard CORS ("*") allowed, localhost bind
#   production   requires API_CORS_ORIGINS to be set; startup aborts otherwise
#                and warns loudly if the origin list still contains "*".
API_ENV=development

# Application identity (shown in OpenAPI and reported by GET /health).
API_APP_NAME=predictive-maintenance-ai
API_APP_VERSION=0.2.0

# Bind address for uvicorn. Production typically wants 0.0.0.0 behind a
# reverse proxy (see docs/deployment.md); keep 127.0.0.1 for local dev.
API_HOST=127.0.0.1
API_PORT=8000

# Directory holding trained artefacts: <dir>/<FD00X>/{preprocessing_pipeline,
# isolation_forest, random_forest, xgboost}.{joblib,json}/
# NOT in git (.gitignore) - produced by scripts/train_*.py or shipped by the
# deployment pipeline. Default resolves to <project root>/models.
# API_MODEL_DIR=models

# Comma-separated browser origins allowed to call the API.
#   development default: "*" (any origin) - local use only.
#   production: MUST list explicit origins, e.g.
#   API_CORS_ORIGINS=https://dashboard.example.com,https://ops.example.com
API_CORS_ORIGINS=*

# uvicorn log level: critical | error | warning | info | debug | trace
API_LOG_LEVEL=info

# SQLAlchemy URL. SQLite default resolves project-relative paths against the
# project root (sqlite:///./data/predictive_maintenance.db -> <root>/data).
# The parent directory is created automatically. On POSIX an absolute path
# needs four slashes: sqlite:////var/lib/pma/predictive_maintenance.db
API_DATABASE_URL=sqlite:///./data/predictive_maintenance.db

# Alert thresholds (defaults shown).
API_ALERT_ELEVATED_FAILURE=0.5
API_ALERT_CRITICAL_FAILURE=0.8
API_ALERT_ANOMALY_ENABLED=true

# ----------------------------------------------------------------------------
# IoT simulator (src/predictive_maintenance/simulator/config.py)
# ----------------------------------------------------------------------------

# Base URL of the backend the simulator pushes readings to.
SIMULATOR_API_URL=http://127.0.0.1:8000

# Number of independent machines to simulate.
SIMULATOR_MACHINE_COUNT=3

# Seconds between sampling rounds.
SIMULATOR_INTERVAL_SECONDS=1.0

# Total simulation time; 0 runs until stopped.
SIMULATOR_DURATION_SECONDS=60.0

# Random seed (reproducible scenarios).
SIMULATOR_SEED=42

# Scenario: normal | developing_degradation | abnormal_vibration |
#           abnormal_temperature | sensor_failure | sudden_anomaly | recovery
SIMULATOR_SCENARIO=normal

# Readings per batch request to the API.
SIMULATOR_BATCH_SIZE=10

# C-MAPSS subset whose models/features the simulator uses (FD001-FD004).
SIMULATOR_DATASET_ID=FD001

# ----------------------------------------------------------------------------
# Frontend (frontend/.env, read at `npm run build` time)
# ----------------------------------------------------------------------------

# Default backend base URL for the dashboard. NOTE: VITE_* variables are
# baked into the production bundle at build time; operators can still point
# the built dashboard at any backend via the in-app settings page (persisted
# in localStorage).
# frontend/.env.production:
VITE_API_BASE_URL=http://127.0.0.1:8000
